{
  "expo": {
    "name": "Healthlog",
    "slug": "healthlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maximeml.healthlog",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Healthlog accède à votre photothèque pour vous permettre de joindre des photos à vos événements de santé (ordonnances, certificats, photos de symptômes).",
        "NSCameraUsageDescription": "Healthlog accède à votre appareil photo pour vous permettre de prendre des photos directement à associer à vos événements de santé.",
        "NSUserNotificationsUsageDescription": "Healthlog utilise les notifications pour vous rappeler la prise de médicaments, les rendez-vous médicaux et autres rappels que vous configurez.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.maximeml.healthlog",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E3A8A"
        }
      ],
      "expo-image-picker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "2mldigital",
          "project": "healthlog",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "CA92.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "C617.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "E174.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "35F9.1"
                  ]
                }
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3aaf9d10-ef57-4233-9b2e-0441628a1568"
      }
    }
  }
}
